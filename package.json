{
  "name": "agy-quota-manager",
  "displayName": "Antigravity Quota Monitor",
  "description": "Live AI model quotas, countdown timers, and gauge indicators for Antigravity IDE",
  "version": "3.7.0",
  "publisher": "dendy",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:agyQuotaDashboard"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agy-quota",
          "title": "Antigravity Quota",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agy-quota": [
        {
          "type": "webview",
          "id": "agyQuotaDashboard",
          "name": "Live Quota Monitor"
        }
      ]
    },
    "commands": [
      {
        "command": "agyQuota.refresh",
        "title": "AGY Quota: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agyQuota.openDashboard",
        "title": "AGY Quota: Open Dashboard"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agyQuota.refresh",
          "when": "view == agyQuotaDashboard",
          "group": "navigation@1"
        }
      ]
    }
  }
}
